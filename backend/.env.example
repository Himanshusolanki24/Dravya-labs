# =====================================================
# Dravya Labs Backend — Environment Configuration
# =====================================================

# ── Security ──
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# ── Supabase ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Helix DB (AI Memory Store — replaces Pinecone) ──
HELIX_DB_API_KEY=your-helix-db-api-key-here
HELIX_DB_API_URL=http://localhost:8080
HELIX_DB_COLLECTION=dravya-health-profiles

# ── Redis Cache ──
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ──
MISTRAL_API_KEY=your-mistral-api-key-here
MODEL_NAME=mistral-large-latest

# Optional — enables multi-provider routing/voting
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── Multi-LLM Routing ──
LLM_SIMPLE_MODEL=mistral:mistral-small-latest
LLM_COMPLEX_MODEL=mistral:mistral-small-latest
LLM_ENSEMBLE_MODELS=openai:gpt-5.6,xai:grok-4.5,anthropic:claude-sonnet-4-5
LLM_JUDGE_MODEL=mistral:mistral-small-latest
LLM_HIGH_CHAIN=openai:gpt-5.6,xai:grok-4.5,openrouter:x-ai/grok-4.5,anthropic:claude-sonnet-4-5,openrouter:openai/gpt-5.6
LLM_MEDIUM_CHAIN=groq:mistral-saba-24b,mistral:mistral-small-latest,google:gemini-2.5-flash,openrouter:mistralai/mistral-small
LLM_LOW_CHAIN=groq:llama-3.3-70b-versatile,deepseek:deepseek-chat,mistral:mistral-small-latest,openrouter:meta-llama/llama-3.3-70b-instruct
LLM_HIGH_DAILY_REQUESTS=20
LLM_HIGH_DAILY_TOKENS=80000
LLM_MEDIUM_DAILY_REQUESTS=50
LLM_MEDIUM_DAILY_TOKENS=200000
LLM_LOW_DAILY_REQUESTS=100
LLM_LOW_DAILY_TOKENS=400000

# ── Feature Flags ──
USE_AGENTSCOPE=true
USE_HIERARCHICAL_ORCHESTRATOR=true
MAX_CRITIC_RETRIES=3
KB_CLASSICAL_COLLECTION=ayurveda_classical
KB_USER_COLLECTION=user_consultations
KB_FEWSHOT_COLLECTION=feedback_fewshot
KB_TOP_K=5
QDRANT_PATH=

# ── Embeddings ──
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ── ML Microservice URLs (blank = client returns "unavailable") ──
SKIN_MODEL_API_URL=
HAIR_MODEL_API_URL=
PCOS_MODEL_API_URL=
DIABETES_MODEL_API_URL=
AUTOIMMUNE_MODEL_API_URL=http://localhost:8003/predict
OBESITY_MODEL_API_URL=
BRAHMA_MODEL_API_URL=http://localhost:8005/predict
DIETPLAIN_MODEL_API_URL=http://localhost:8004/predict
HERBS_MODEL_API_URL=http://localhost:8002/predict
SYMPTOM_TREATMENT_MODEL_API_URL=http://localhost:8006/predict
MODEL_CLIENTS_TIMEOUT=30

# ── MCP (Cursor IDE + chat connectors) ──
# Fill tokens in .cursor/mcp.json for Cursor, and/or connect from Chat → + tools.
NOTION_TOKEN=
OBSIDIAN_API_KEY=
OBSIDIAN_API_URL=https://127.0.0.1:27124
GITHUB_PERSONAL_ACCESS_TOKEN=
HOST=0.0.0.0
PORT=8000
DEBUG=False